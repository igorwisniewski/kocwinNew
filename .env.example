# ==========================================================
# KONFIGURACJA BAZY MYSQL NA HOSTINGU SEOHOST DLA CMS
# ==========================================================
# Wpisz poniżej dane dostępowe do bazy utworzonej w cPanel / DirectAdmin na SEOHOST.
# PAMIĘTAJ: W cPanel na SEOHOST w zakładce "Zdalny MySQL" (Remote MySQL) 
# dodaj adres IP serwera, na którym stoi aplikacja (lub '%' na czas wdrożenia).

DB_HOST=localhost
DB_PORT=3306
DB_USER=twojlogin_user
DB_PASSWORD='WPISZ_SILNE_HASLO_DO_BAZY'
DB_NAME=twojlogin_dbname
DB_SSL=false

# ==========================================================
# DANE LOGOWANIA DO PANELU CMS (/admin)
# ==========================================================
# Używaj pojedynczych cudzysłowów ('...'), jeśli hasło zawiera znaki specjalne (#, $, \, !, `).
ADMIN_USER=admin
ADMIN_PASSWORD='WPISZ_SILNE_HASLO_ADMINA_MIN_12_ZNAKOW'
JWT_SECRET='WYGENERUJ_UNIKALNY_LOSOWY_CIAG_MIN_32_ZNAKI'
